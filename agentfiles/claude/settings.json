{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(find /*)",
      "Bash(* find /*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Read(**/*ssh*)",
      "Read(**/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.der)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*password*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Bash(*ssh*)",
      "Bash(*.env)",
      "Bash(*.env*)",
      "Bash(*.key)",
      "Bash(*.pem)",
      "Bash(*.p12)",
      "Bash(*.pfx)",
      "Bash(*.keystore)",
      "Bash(*.jks)",
      "Bash(*.der)",
      "Bash(*credential*)",
      "Bash(*secret*)",
      "Bash(*password*)",
      "Bash(.netrc)",
      "Bash(.npmrc)",
      "Bash(.pypirc)"
    ],
    "ask": [
      "Bash(git *)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "~/.claude/memory"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Glob|Grep|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ~/.claude/hooks/guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "theme": "dark"
}
